# === Repo/dev files not needed in the build context ===
.git/
.gitignore
node_modules/
config/
opencode.json
AGENTS.md
package.json
package-lock.json
README.md
.env

# === Grav runtime data (auto-generated or supplied by image skeleton) ===
user/data/
user/cache/
user/tmp/
user/logs/
user/accounts/
user/config/versions.yaml
user/config/media.yaml

# === Grav secrets & credentials (injected at runtime via entrypoint.sh) ===
user/config/security-private.php
user/config/plugins/api-private.php
user/config/plugins/brevo.yaml
user/config/plugins/email.yaml
user/config/plugins/form-captcha-hcaptcha.yaml

# === Plugins (bundled with image or installed via GPM) ===
user/plugins/*
!user/plugins/signature-attachment/
user/plugins/signature-attachment/vendor/

# === Themes (bundled with image; only our child theme is tracked) ===
user/themes/*
!user/themes/dckn/
