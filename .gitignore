# === User-specific environment (UID/GID per developer) ===
.env

# === Container runtime (managed by linuxserver/grav image) ===
/config/

# === opencode config (contains API keys) ===
opencode.json
AGENTS.md

# === Node dependencies (installed via npm install, not tracked) ===
node_modules/
package.json
package-lock.json

# === Grav runtime data (auto-generated: caches, indexes, feeds, scheduler) ===
user/data/

# === Apache-only defense files (inert on this nginx deployment; supplied by image skeleton) ===
user/.htaccess
user/accounts/.htaccess
user/config/.htaccess

# === Accounts (runtime, contains password hashes; skeleton created by image) ===
user/accounts/*

# === Grav secrets (auto-generated, must never be committed) ===
user/config/plugins/api-private.php
user/config/security-private.php
user/accounts/admin.yaml

# === Plugin configs with credentials (per-environment, must never be committed) ===
user/config/plugins/brevo.yaml
user/config/plugins/email.yaml

# === hCaptcha keys (per-environment, must never be committed) ===
user/config/plugins/form-captcha-hcaptcha.yaml

# === Auto-generated metadata ===
user/config/versions.yaml
user/config/media.yaml

# === Plugins (installed via setup-plugins.sh, not content we author) ===
user/plugins/*
!user/plugins/signature-attachment/
user/plugins/signature-attachment/vendor/

# === Themes (bundled with image; only our child theme is tracked) ===
user/themes/*
!user/themes/dckn/
