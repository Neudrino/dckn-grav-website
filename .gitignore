# === Container runtime (managed by linuxserver/grav image) ===
/config/

# === opencode config (contains API keys) ===
opencode.json

# === Node dependencies (installed via npm install, not tracked) ===
node_modules/

# === Grav runtime data (auto-generated: caches, indexes, feeds, scheduler) ===
user/data/

# === Grav secrets (auto-generated, must never be committed) ===
user/config/plugins/api-private.php
user/config/security-private.php

# === Auto-generated metadata ===
user/config/versions.yaml
user/config/media.yaml

# === Plugins (installed via setup-plugins.sh, not content we author) ===
user/plugins/*
!user/plugins/signature-attachment/

# === Theme (bundled with image; only our custom overrides are tracked) ===
user/themes/*
!user/themes/quark2/
user/themes/quark2/*
!user/themes/quark2/css/
user/themes/quark2/css/*
!user/themes/quark2/css/custom.css
!user/themes/quark2/templates/
user/themes/quark2/templates/*
!user/themes/quark2/templates/projekte.html.twig
!user/themes/quark2/templates/home.html.twig
!user/themes/quark2/templates/event.html.twig
!user/themes/quark2/templates/formular.html.twig
!user/themes/quark2/blueprints/
user/themes/quark2/blueprints/*
!user/themes/quark2/blueprints/event.yaml
