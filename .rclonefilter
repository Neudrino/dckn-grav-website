# rclone filter for the deploy sync (./user/ -> NETCUP:<REMOTE_PATH>/user/)
# Paths are relative to user/. Excluded files are neither uploaded nor
# overwritten, and rclone sync will not delete them on the server.
#
# server-managed: never overwrite, never delete
- /accounts/**
- /data/**
- .htaccess
# Grav runtime dirs (regenerated by Grav, logs must survive)
- /cache/**
- /tmp/**
- /logs/**
# site-wide media uploaded via admin panel
- /images/**
- /config/security-private.php
- /config/versions.yaml
- /config/media.yaml
# plugin configs: uploaded by a separate rclone copy, never deleted by sync
- /config/plugins/**
# plugins: only signature-attachment is repo-managed, its vendor/ lives server-side
- /plugins/signature-attachment/vendor/**
+ /plugins/signature-attachment/**
- /plugins/**
# themes: only dckn is repo-managed, quark2 etc. stay untouched
+ /themes/dckn/**
- /themes/**
