<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Auslagenerstattung</title>
<link rel="stylesheet" href="{{ pdf_css_path }}">
</head>
<body>

<header>
{% if logo_data_uri is defined and logo_data_uri %}
<table class="page-header">
  <tr><td><img src="{{ logo_data_uri }}" class="logo"></td></tr>
</table>
{% endif %}
</header>

<h1>Auslagenerstattung</h1>
<p class="subtitle">Das Co-Kreative Netzwerk e.V.</p>

{% set antragsteller = form.value('antragsteller')|default('') %}
{% set email = form.value('email')|default('') %}
{% set leistungsdatum = form.value('leistungsdatum')|default('') %}
{% set projektname = form.value('projektname')|default('') %}
{% set begruendung = form.value('begruendung')|default('') %}
{% set betrag = form.value('betrag')|default(0) %}
{% set anzahl_belege = form.value('anzahl_belege')|default('') %}
{% set belege = form.value('belege')|default([]) %}
{% set kontoinhaber = form.value('kontoinhaber')|default('') %}
{% set iban = form.value('iban')|default('') %}
{% set unterschrift = form.value('unterschrift')|default('') %}

<h2>Antragsteller:in</h2>
<table class="kv">
  {% if antragsteller %}<tr><td class="label">Name</td><td class="value">{{ antragsteller|e }}</td></tr>{% endif %}
  {% if email %}<tr><td class="label">E-Mail</td><td class="value">{{ email|e }}</td></tr>{% endif %}
  {% if leistungsdatum %}<tr><td class="label">Leistungsdatum</td><td class="value">{{ leistungsdatum|e }}</td></tr>{% endif %}
  {% if projektname %}<tr><td class="label">Projektname</td><td class="value project-title">{{ projektname|e }}</td></tr>{% endif %}
</table>

{% if begruendung %}
<h2>Begründung</h2>
<p>Es wird die Erstattung folgender Auslagen beantragt. Begründung:</p>
<p class="emphasis">{{ begruendung|nl2br }}</p>
{% endif %}

{% if betrag %}
<div class="amount">{{ betrag|number_format(2, ',', ' ') }} Euro (brutto)</div>
{% endif %}

<h2>Belege</h2>
{% if anzahl_belege %}<p>Anzahl der Belege: <strong>{{ anzahl_belege|e }}</strong></p>{% endif %}
{% if belege is iterable %}
  {% if belege|length %}
  <ul>
    {% for file in belege %}
    <li>{{ file.name|default('Datei')|e }}</li>
    {% endfor %}
  </ul>
  {% endif %}
{% elseif belege %}
<ul>
  <li>{{ belege|e }}</li>
</ul>
{% endif %}
<p class="note">Die Belege sind dieser E-Mail als Anhang beigefügt.</p>

<h2>Bankverbindung</h2>
<table class="kv">
  {% if kontoinhaber %}<tr><td class="label">Kontoinhaber:in</td><td class="value">{{ kontoinhaber|e }}</td></tr>{% endif %}
  {% if iban %}<tr><td class="label">IBAN</td><td class="value">{{ iban|e }}</td></tr>{% endif %}
</table>

<h2>Bestätigung</h2>
<p class="consent">{% if antragsteller %}{{ antragsteller|e }} hat zugestimmt: {% endif %}„Ich versichere, dass alle Angaben vollständig und richtig sind.“</p>

{% if unterschrift starts with 'data:image' %}
<img src="{{ unterschrift }}" class="signature-img">
{% endif %}

<p class="created">Dieses Dokument wurde automatisch über das Auslagenerstattungsformular auf dckn.de erstellt und gesendet am {{ created_at|e }}.</p>

<footer>
{% set d = site.dckn|default([]) %}
{% if d %}
<table class="footer">
  <tr>
    <td>
      {% if d.name %}<strong>{{ d.name|e }}</strong>{% endif %}
      {% if d.address is iterable %}
        {% for line in d.address %}<br>{{ line|e }}{% endfor %}
      {% elseif d.address %}<br>{{ d.address|e }}{% endif %}
    </td>
    <td class="right">
      {% if d.register %}{{ d.register|e }}{% endif %}
      {% if d.register and d.tax_id %}<br>{% endif %}
      {% if d.tax_id %}{{ d.tax_id|e }}{% endif %}
      {% if d.url %}
        {% if d.register or d.tax_id %}<br>{% endif %}<a href="{{ d.url|e }}">{{ d.url|e }}</a>
      {% endif %}
    </td>
  </tr>
</table>
{% endif %}
</footer>

</body>
</html>
