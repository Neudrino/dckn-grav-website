<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Projektantrag</title>
<link rel="stylesheet" href="{{ pdf_css_path }}">
</head>
<body>

<header>
{% if logo_data_uri is defined and logo_data_uri %}
<table class="page-header">
  <tr><td><img src="{{ logo_data_uri }}" class="logo"></td></tr>
</table>
{% endif %}
</header>

<h1>Projektantrag</h1>
<p class="subtitle">Das Co-Kreative Netzwerk e.V.</p>

{% set antragsteller = form.value('antragsteller')|default('') %}
{% set meldeadresse = form.value('meldeadresse')|default('') %}
{% set email = form.value('email')|default('') %}
{% set telefon = form.value('telefon')|default('') %}
{% set projekttitel = form.value('projekttitel')|default('') %}
{% set startdatum = form.value('startdatum')|default('') %}
{% set veranstaltungsart = form.value('veranstaltungsart')|default('') %}
{% set ort = form.value('ort')|default('') %}
{% set gesamtumsatz = form.value('gesamtumsatz')|default('') %}
{% set groesste_einzelausgabe = form.value('groesste_einzelausgabe')|default('') %}
{% set mitorganisatoren = form.value('mitorganisatoren')|default('') %}
{% set teilnehmer_min = form.value('teilnehmer_min')|default('') %}
{% set teilnehmer_max = form.value('teilnehmer_max')|default('') %}
{% set zwecke = form.value('zwecke')|default([]) %}
{% set kurzbeschreibung = form.value('kurzbeschreibung')|default('') %}
{% set cokreation = form.value('cokreation')|default('') %}
{% set kalkulation = form.value('kalkulation')|default([]) %}
{% set unterschrift = form.value('unterschrift')|default('') %}

<h2>Antragsteller:in</h2>
<table class="kv">
  {% if antragsteller %}<tr><td class="label">Name</td><td class="value">{{ antragsteller|e }}</td></tr>{% endif %}
  {% if meldeadresse %}<tr><td class="label">Meldeadresse</td><td class="value">{{ meldeadresse|e }}</td></tr>{% endif %}
  {% if email %}<tr><td class="label">E-Mail</td><td class="value">{{ email|e }}</td></tr>{% endif %}
  {% if telefon %}<tr><td class="label">Telefon</td><td class="value">{{ telefon|e }}</td></tr>{% endif %}
</table>

<h2>Projekt</h2>
<table class="kv">
  {% if projekttitel %}<tr><td class="label">Projekttitel</td><td class="value project-title">{{ projekttitel|e }}</td></tr>{% endif %}
  {% if startdatum %}<tr><td class="label">Startdatum</td><td class="value">{{ startdatum|e }}</td></tr>{% endif %}
  {% if veranstaltungsart %}<tr><td class="label">Veranstaltungsart</td><td class="value">{{ veranstaltungsart|e }}</td></tr>{% endif %}
  {% if ort %}<tr><td class="label">Adresse / Ort</td><td class="value">{{ ort|e }}</td></tr>{% endif %}
  {% if mitorganisatoren %}<tr><td class="label">Mitorganisator:inn:en</td><td class="value">{{ mitorganisatoren|e }}</td></tr>{% endif %}
  {% if teilnehmer_min or teilnehmer_max %}<tr><td class="label">Teilnehmerzahl</td><td class="value">min. {{ teilnehmer_min|e }} – max. {{ teilnehmer_max|e }}</td></tr>{% endif %}
</table>

<h2>Zahlen</h2>
<table class="kv">
  {% if gesamtumsatz %}<tr><td class="label">Gesamtumsatz</td><td class="value">{{ gesamtumsatz|number_format(2, ',', ' ') }} Euro</td></tr>{% endif %}
  {% if groesste_einzelausgabe %}<tr><td class="label">Größte Einzelausgabe</td><td class="value">{{ groesste_einzelausgabe|number_format(2, ',', ' ') }} Euro</td></tr>{% endif %}
</table>

<h2>Folgende Vereinszwecke werden gefördert:</h2>
{% if zwecke is iterable %}
  {% if zwecke|length %}
  <ul>
    {% for z in zwecke %}
    <li>{{ z|e }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="note">Keine Angaben.</p>
  {% endif %}
{% elseif zwecke %}
<ul>
  <li>{{ zwecke|e }}</li>
</ul>
{% else %}
<p class="note">Keine Angaben.</p>
{% endif %}

<h2>Beschreibung</h2>
{% if kurzbeschreibung %}
<p>{{ kurzbeschreibung|nl2br }}</p>
{% endif %}
{% if cokreation %}
<h2>Förderung von Co-Kreation erfolgt auf folgende Weise</h2>
<p>{{ cokreation|nl2br }}</p>
{% endif %}

<h2>Kalkulation</h2>
{% if kalkulation is iterable %}
  {% for file in kalkulation %}
  <p>{{ file.name|default('Datei')|e }} <span class="note">(als Anhang beigefügt)</span></p>
  {% endfor %}
{% elseif kalkulation %}
<p>{{ kalkulation|e }} <span class="note">(als Anhang beigefügt)</span></p>
{% else %}
<p class="note">Keine Kalkulation angehängt.</p>
{% endif %}

<h2>Bestätigung</h2>
<p class="consent">{% if antragsteller %}{{ antragsteller|e }} hat zugestimmt: {% endif %}„Ich beachte die Rahmenbedingungen und versichere, dass alle Angaben vollständig und richtig sind.“</p>

{% if unterschrift starts with 'data:image' %}
<img src="{{ unterschrift }}" class="signature-img">
{% endif %}

<p class="created">Dieses Dokument wurde automatisch über das Projektantragsformular auf dckn.de erstellt und gesendet am {{ created_at|e }}.</p>

<footer>
{% set d = site.dckn|default([]) %}
{% if d %}
<table class="footer">
  <tr>
    <td>
      {% if d.name %}<strong>{{ d.name|e }}</strong>{% endif %}
      {% if d.address is iterable %}
        {% for line in d.address %}<br>{{ line|e }}{% endfor %}
      {% elseif d.address %}<br>{{ d.address|e }}{% endif %}
    </td>
    <td class="right">
      {% if d.register %}{{ d.register|e }}{% endif %}
      {% if d.register and d.tax_id %}<br>{% endif %}
      {% if d.tax_id %}{{ d.tax_id|e }}{% endif %}
      {% if d.url %}
        {% if d.register or d.tax_id %}<br>{% endif %}<a href="{{ d.url|e }}">{{ d.url|e }}</a>
      {% endif %}
    </td>
  </tr>
</table>
{% endif %}
</footer>

</body>
</html>
