<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Formular</title>
<link rel="stylesheet" href="{{ pdf_css_path }}">
</head>
<body>

<header>
{% if logo_data_uri is defined and logo_data_uri %}
<table class="page-header">
  <tr><td><img src="{{ logo_data_uri }}" class="logo"></td></tr>
</table>
{% endif %}
</header>

<h1>Formular</h1>

<table class="kv">
  {% for field in form.fields %}
    {% set show_field = attribute(field, 'input@') ?? field.store ?? true %}
    {% if show_field and not field.fields %}
      {% set value = form.value(field.name) %}
      {% if value %}
        <tr>
          <td class="label">{{ field.label|e }}</td>
          <td class="value">
            {% if field.type == 'signature' and value starts with 'data:image' %}
              <img src="{{ value }}" class="signature-img" />
            {% elseif field.type == 'file' %}
              {% if value is iterable %}
                <ul>
                  {% for file in value %}
                    <li>{{ file.name|default('Datei')|e }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                {{ value|e }}
              {% endif %}
            {% elseif field.type == 'checkbox' %}
              {{ value == 1 ? 'Ja' : 'Nein' }}
            {% else %}
              {{ value|e|nl2br }}
            {% endif %}
          </td>
        </tr>
      {% endif %}
    {% endif %}
  {% endfor %}
</table>

<footer>
{% set d = site.dckn|default([]) %}
{% if d %}
<table class="footer">
  <tr>
    <td>
      {% if d.name %}<strong>{{ d.name|e }}</strong>{% endif %}
      {% if d.address is iterable %}
        {% for line in d.address %}<br>{{ line|e }}{% endfor %}
      {% elseif d.address %}<br>{{ d.address|e }}{% endif %}
    </td>
    <td class="right">
      {% if d.register %}{{ d.register|e }}{% endif %}
      {% if d.register and d.tax_id %}<br>{% endif %}
      {% if d.tax_id %}{{ d.tax_id|e }}{% endif %}
      {% if d.url %}
        {% if d.register or d.tax_id %}<br>{% endif %}<a href="{{ d.url|e }}">{{ d.url|e }}</a>
      {% endif %}
    </td>
  </tr>
</table>
{% endif %}
</footer>

</body>
</html>
