<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body {
    font-family: DejaVu Sans, sans-serif;
    font-size: 11pt;
    color: #222;
    margin: 2cm;
  }
  h1 {
    font-size: 16pt;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 13pt;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .field {
    margin-bottom: 0.75rem;
  }
  .field-label {
    font-weight: bold;
  }
  .signature-img {
    max-width: 300px;
    border: 1px solid #ccc;
    padding: 0.5rem;
  }
  .file-list {
    font-style: italic;
    color: #666;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  td {
    padding: 0.3rem 0;
    vertical-align: top;
  }
  td.label {
    font-weight: bold;
    width: 40%;
    padding-right: 1rem;
  }
</style>
</head>
<body>

<h1>Auslagenerstattungsantrag</h1>
<h2>Das co-kreative Netzwerk e.V.</h2>

<table>
  {% for field in form.fields %}
    {% set show_field = attribute(field, 'input@') ?? field.store ?? true %}
    {% if show_field and not field.fields %}
      {% set value = form.value(field.name) %}
      {% if value %}
        <tr>
          <td class="label">{{ field.label|e }}</td>
          <td>
            {% if field.type == 'signature' and value starts with 'data:image' %}
              <img src="{{ value }}" class="signature-img" />
            {% elseif field.type == 'file' %}
              {% if value is iterable %}
                <ul class="file-list">
                  {% for file in value %}
                    <li>{{ file.name|default('Datei')|e }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                {{ value|e }}
              {% endif %}
            {% elseif field.type == 'checkbox' %}
              {{ value == 1 ? 'Ja' : 'Nein' }}
            {% else %}
              {{ value|e|nl2br }}
            {% endif %}
          </td>
        </tr>
      {% endif %}
    {% endif %}
  {% endfor %}
</table>

</body>
</html>
