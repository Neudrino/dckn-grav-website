<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Projektantrag</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;">
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" style="width:100%;max-width:600px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:8px;font-family:Arial,Helvetica,sans-serif;color:#222222;font-size:14px;line-height:1.6;">
                <tr>
                    <td style="padding:28px 32px 0;">
                        <img src="cid:dckn-logo" alt="Das co-kreative Netzwerk e.V." width="150" style="display:block;width:150px;max-width:150px;height:auto;border:0;">
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 32px 0;">
                        <h2 style="margin:0;font-size:22px;line-height:1.3;color:#c6530a;">Projektantrag</h2>
                        <p style="margin:4px 0 0;font-size:12px;color:#6b7280;">Das co-kreative Netzwerk e.V.</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Antragsteller:in</h3>
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;">
                            <tr>
                                <td style="padding:4px 16px 4px 0;width:35%;color:#6b7280;">Name</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('antragsteller')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Meldeadresse</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('meldeadresse')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">E-Mail</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('email')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Telefon</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('telefon')|default('–') }}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Projekt</h3>
                        <p style="margin:0 0 8px;font-size:16px;font-weight:bold;color:#c6530a;">{{ form.value('projekttitel')|default('–') }}</p>
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;">
                            <tr>
                                <td style="padding:4px 16px 4px 0;width:35%;color:#6b7280;">Startdatum</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('startdatum')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Veranstaltungsart</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('veranstaltungsart')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Adresse / Ort</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('ort')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Mitorganisator:inn:en</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('mitorganisatoren')|default('–') }}</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Teilnehmerzahl</td>
                                <td style="padding:4px 0;font-weight:bold;">min. {{ form.value('teilnehmer_min')|default('–') }} – max. {{ form.value('teilnehmer_max')|default('–') }}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                {% if form.value('gesamtumsatz') or form.value('groesste_einzelausgabe') %}
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Zahlen</h3>
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;">
                            {% if form.value('gesamtumsatz') %}
                            <tr>
                                <td style="padding:4px 16px 4px 0;width:35%;color:#6b7280;">Gesamtumsatz</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('gesamtumsatz')|number_format(2, ',', ' ') }} Euro</td>
                            </tr>
                            {% endif %}
                            {% if form.value('groesste_einzelausgabe') %}
                            <tr>
                                <td style="padding:4px 16px 4px 0;color:#6b7280;">Größte Einzelausgabe</td>
                                <td style="padding:4px 0;font-weight:bold;">{{ form.value('groesste_einzelausgabe')|number_format(2, ',', ' ') }} Euro</td>
                            </tr>
                            {% endif %}
                        </table>
                    </td>
                </tr>
                {% endif %}
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Folgende Vereinszwecke werden gefördert:</h3>
                        {% set zwecke = form.value('zwecke') %}
                        {% if zwecke is iterable and zwecke is not empty %}
                        <ul style="margin:0;padding:0 0 0 20px;">
                            {% for zweck in zwecke %}
                            <li style="margin:2px 0;">{{ zweck }}</li>
                            {% endfor %}
                        </ul>
                        {% elseif zwecke %}
                        <ul style="margin:0;padding:0 0 0 20px;">
                            <li style="margin:2px 0;">{{ zwecke }}</li>
                        </ul>
                        {% else %}
                        <p style="margin:0;color:#6b7280;">(keine Angabe)</p>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Beschreibung</h3>
                        {% if form.value('kurzbeschreibung') %}
                        <p style="margin:0 0 12px;">{{ form.value('kurzbeschreibung')|nl2br }}</p>
                        {% endif %}
                    </td>
                </tr>
                {% if form.value('cokreation') %}
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Förderung von Co-Kreation erfolgt auf folgende Weise</h3>
                        <p style="margin:0 0 12px;">{{ form.value('cokreation')|nl2br }}</p>
                    </td>
                </tr>
                {% endif %}
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Kalkulation</h3>
                        {% set kalkulation = form.value('kalkulation') %}
                        {% set kalk_file = kalkulation is iterable ? (kalkulation is not empty ? kalkulation|first : null) : kalkulation %}
                        {% set kalk_name = kalk_file is iterable ? (kalk_file.name ?? null) : kalk_file %}
                        <p style="margin:0;">{% if kalk_name %}<strong>{{ kalk_name }}</strong> (als Anhang beigefügt){% else %}–{% endif %}</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 32px 0;">
                        <h3 style="margin:0 0 8px;padding-bottom:4px;font-size:14px;color:#222222;border-bottom:1px solid #e5e7eb;">Bestätigung</h3>
                        <p style="margin:0 0 12px;">{% if form.value('antragsteller') %}{{ form.value('antragsteller') }} hat zugestimmt: {% endif %}„Ich beachte die Rahmenbedingungen und versichere, dass alle Angaben vollständig und richtig sind.“</p>
                        {% if form.value('unterschrift')|default('') starts with 'data:image' %}
                        <img src="cid:projektantrag-signature" alt="Unterschrift" width="250" style="display:block;width:250px;max-width:250px;height:auto;border:1px solid #e5e7eb;border-radius:4px;padding:4px;background-color:#ffffff;">
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 32px 28px;border-top:1px solid #e5e7eb;font-size:11px;color:#9ca3af;">
                        Diese E-Mail wurde automatisch über das Projektantragsformular auf dckn.de erstellt und gesendet.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
