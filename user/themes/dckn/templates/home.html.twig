{% extends 'partials/base.html.twig' %}

{% block content %}
    <article class="content-item">
        {% set intro_text = page.header.verein_intro %}

        {{ page.summary()|raw }}

        {# Three-column layout: Unser Verein | Co-Kreative Projekte | Newsletter #}
        <div class="three-col">
            <div class="verein-tile">
                <h3>Unser Verein</h3>
                {% if intro_text %}
                <p>{{ intro_text }}</p>
                {% endif %}
                <a class="btn" href="/der-verein/vereinsmitglied-werden">Mitglied werden</a>
                {% set rollen_page = page.find(config.theme['rollen-page'] ?? '/der-verein/unterstuetze-uns') %}
                {% if rollen_page %}
                {% set rollen = rollen_page.children.visible %}
                {% if rollen|length > 0 %}
                <h3>Unterstütze uns</h3>
                <div class="rollen-list">
                    {% for rolle in rollen %}
                        {% include 'partials/rolle-card.html.twig' with {page: rolle} %}
                    {% endfor %}
                </div>
                <a class="btn" href="{{ rollen_page.url }}">Alle Rollen ansehen</a>
                {% endif %}
                {% endif %}
            </div>
            <div class="projekte-tile">
                <h3>Co-Kreative Projekte</h3>
                <div class="home-projekte-list">
                    {% set projekte = page.find('/co-kreative-projekte') %}
                    {% for child in projekte.children.visible %}
                        {% set image = child.media.images|first %}
                        {% if child.header.cover %}
                            {% set image = media[child.header.cover] ?? image %}
                        {% endif %}
                        {% set event = child.header.event %}
                        <a class="projekt-mini-card" href="{{ child.url }}">
                            {% if image %}
                            <div class="projekt-mini-image">{{ image.cropZoom(300, 170).html|raw }}</div>
                            {% endif %}
                            <div class="projekt-mini-body">
                                <strong>{{ child.title }}</strong>
                                {% if event.startdatum %}
                                <span class="projekt-mini-datum">{% include 'partials/projekt-date-range.html.twig' with {start: event.startdatum, end: event.enddatum} %}</span>
                                {% endif %}
                                {% if event.ort %}
                                <span class="projekt-mini-ort"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{ event.ort }}</span>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
                <a class="btn" href="/co-kreative-projekte">Alle Projekte</a>
            </div>
            <div class="newsletter-tile">
                <h3>Newsletter</h3>
                {% include "forms/form.html.twig" %}
            </div>
        </div>

    </article>
{% endblock %}
