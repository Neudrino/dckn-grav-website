{% if start and end %}
    {% set s = start|split('-') %}
    {% set e = end|split('-') %}
    {% if s.0 == e.0 and s.1 == e.1 %}
        {{ s.2 }}.–{{ e.2 }}.{{ s.1 }}.{{ s.0 }}
    {% elseif s.0 == e.0 %}
        {{ s.2 }}.{{ s.1 }}.–{{ e.2 }}.{{ e.1 }}.{{ s.0 }}
    {% else %}
        {{ s.2 }}.{{ s.1 }}.{{ s.0 }}–{{ e.2 }}.{{ e.1 }}.{{ e.0 }}
    {% endif %}
{% elseif start %}
    {% set s = start|split('-') %}
    {{ s.2 }}.{{ s.1 }}.{{ s.0 }}
{% endif %}
